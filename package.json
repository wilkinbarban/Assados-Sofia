{
  "name": "asados-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace @asados/web",
    "build": "npm run build --workspace @asados/web",
    "start": "npm run start --workspace @asados/web",
    "lint": "eslint",
    "lin": "npm run lint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
