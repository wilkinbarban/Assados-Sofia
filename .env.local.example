# Local development only. Obtain the two keys with `npm run supabase:status`.
# Never replace these localhost values with a hosted Supabase project in local tests.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
# Optional in Docker production; server-side clients use this private URL.
SUPABASE_INTERNAL_URL=http://api-gw:8000

# Application URL used by the local Auth redirect flow.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
