#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077

function rotate_credential() {
  local credential_directory="$1"
  local credential_path="$credential_directory/asados.slice2.staging-secret.cred"
  local backup_path="$credential_path.revoked"
  local temporary_path

  install -d -o root -g root -m 0700 "$credential_directory"
  temporary_path="$(mktemp --tmpdir="$credential_directory" .asados.slice2-staging-secret.cred.XXXXXX)"
  trap 'rm -f -- "$temporary_path" "$backup_path"' EXIT

  systemd-ask-password --no-tty --echo=masked -n --id=asados-slice2-staging-secret --timeout=0 \
    'Enter the Asados Slice 2 staging secret key' \
    | systemd-creds encrypt --with-key=host --name=staging-secret - "$temporary_path"

  chown root:root "$temporary_path"
  chmod 0600 "$temporary_path"

  if [[ -e "$credential_path" || -L "$credential_path" ]]; then
    [[ -f "$credential_path" && ! -L "$credential_path" ]]
    rm -f -- "$backup_path"
    ln -- "$credential_path" "$backup_path"
  fi

  mv -f -- "$temporary_path" "$credential_path"
  rm -f -- "$backup_path"
  trap - EXIT
}

function main() {
  if [[ "$(id -u)" -ne 0 ]]; then
    exit 1
  fi

  rotate_credential /etc/credstore.encrypted
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
