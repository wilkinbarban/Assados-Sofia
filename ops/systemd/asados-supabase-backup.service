[Unit]
Description=Back up Asados self-hosted Supabase
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
TimeoutStartSec=30m
Environment=ASADOS_SUPABASE_BACKUP_ROOT=/var/backups/asados/supabase
Environment=ASADOS_SUPABASE_BACKUP_RETENTION_DAYS=14
ExecStart=/usr/local/lib/asados/repo/ops/supabase/scheduled-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/backups/asados/supabase
