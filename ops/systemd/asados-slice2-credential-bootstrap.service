[Unit]
Description=Asados Slice 2 staging credential bootstrap
Documentation=file:///usr/local/share/doc/asados/slice2-credential-bootstrap.md

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/bash /usr/local/lib/asados/provision-slice2-staging-secret
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/credstore.encrypted /run/systemd/ask-password
